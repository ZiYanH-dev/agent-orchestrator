# ===== 复制此文件为 .env 并填入真实值 =====
#   cp .env.example .env
#   ⚠️ .env 已被 .gitignore 忽略，勿提交真实密钥

# ---- 应用 ----
DEBUG=false
BACKEND_PORT=8765
FRONTEND_PORT=5872

# ---- PostgreSQL + pgvector ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_demo

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- Embedding（OpenAI 兼容协议）----
# 本地用 Ollama 兼容端点，或任意 OpenAI 兼容服务（OpenAI/阿里云百炼/DeepSeek...）
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=your-embed-api-key
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768

# ---- LLM（OpenAI 兼容协议）----
# 例：阿里云百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-turbo
LLM_TEMPERATURE=0.1

# ---- 安全 / JWT ----
# 生产环境必须替换为随机长字符串
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- CORS 白名单（逗号分隔）----
CORS_ORIGINS=http://127.0.0.1:5872,http://localhost:5872

# ---- RAG 参数 ----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=3
VECTOR_DIMENSION=768
